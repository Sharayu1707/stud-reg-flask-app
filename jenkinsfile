pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/Sharayu1707/stud-reg-flask-app.git'
            }
        }

        stage('Setup Python Environment') {
            steps {
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install --upgrade pip
                pip install -r requirements.txt
                '''
            }
        }

        stage('Stop Old App') {
            steps {
                sh '''
                pkill -f app.py || true
                '''
            }
        }

        stage('Run Flask App') {
            steps {
                sh '''
                nohup python3 app.py > output.log 2>&1 &
                '''
            }
        }

        stage('Verify App Running') {
            steps {
                sh '''
                sleep 5
                curl http://localhost:5000 || true
                '''
            }
        }
    }
}
